table produccion_mensual
	lineageTag: 2448a646-7cd2-4640-80b7-81d82964811d
	sourceLineageTag: [fact].[produccion_mensual]

	measure 'Petróleo (m³)' = SUM ( produccion_mensual[prod_pet] )
		formatString: #,0
		displayFolder: Producción
		lineageTag: 3a1a96e3-d3f2-415d-a593-8a6b7f58230d

	measure 'Gas (miles de m³)' = SUM ( produccion_mensual[prod_gas] )
		formatString: #,0
		displayFolder: Producción
		lineageTag: c005da49-61b9-404e-8040-42d4c3c124a0

	measure 'Agua (m³)' = SUM ( produccion_mensual[prod_agua] )
		formatString: #,0
		displayFolder: Producción
		lineageTag: 3b30f57f-6680-4048-9b16-2b17387f1895

	measure 'Petróleo (bbl)' = [Petróleo (m³)] * 6.28981
		formatString: #,0
		displayFolder: Producción
		lineageTag: 5b8ccda2-1801-463f-beff-236fd715d5bd

	measure 'Pozos que declararon' = COUNTROWS ( SUMMARIZE ( produccion_mensual, pozo[idpozo] ) )
		formatString: #,0
		displayFolder: Producción
		lineageTag: ada57a39-70a4-472a-8013-817fa74db27d

	measure 'Petróleo por pozo (m³)' = DIVIDE ( [Petróleo (m³)], [Pozos que declararon] )
		formatString: #,0.0
		displayFolder: Producción
		lineageTag: 68464b61-dc5e-4be5-a261-485ef01d604f

