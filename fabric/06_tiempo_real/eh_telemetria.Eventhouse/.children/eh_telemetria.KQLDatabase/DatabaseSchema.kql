.create-merge table telemetria (idpozo:long, ts:datetime, presion_bar:real, caudal_m3d:real, temperatura_c:real) 
.create-or-alter table telemetria ingestion json mapping 'telemetria_json'
```
[{"Properties":{"Path":"$.idpozo"},"column":"idpozo","datatype":"long"},{"Properties":{"Path":"$.ts"},"column":"ts","datatype":"datetime"},{"Properties":{"Path":"$.presion_bar"},"column":"presion_bar","datatype":"real"},{"Properties":{"Path":"$.caudal_m3d"},"column":"caudal_m3d","datatype":"real"},{"Properties":{"Path":"$.temperatura_c"},"column":"temperatura_c","datatype":"real"}]
