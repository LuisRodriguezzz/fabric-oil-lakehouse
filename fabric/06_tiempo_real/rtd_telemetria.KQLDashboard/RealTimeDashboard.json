  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "060e9aee-e5b2-40e6-9f4f-1058e2419495"
      },
      "text": "let pozos = external_table('dim_pozo')\r\n    | where es_actual == true\r\n    | project idpozo, sigla, formacion, tipoextraccion;\r\ntelemetria\r\n| summarize arg_max(ts, *) by idpozo          // la última lectura de cada pozo\r\n| join kind=leftouter pozos on idpozo\r\n| project idpozo, sigla, formacion, tipoextraccion, ts, presion_bar, caudal_m3d, temperatura_c\r\n| order by caudal_m3d desc",
      "id": "dd783251-394f-4b34-9c41-ce892085534a",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "060e9aee-e5b2-40e6-9f4f-1058e2419495"
      },
      "text": "telemetria\r\n| where ts between (_startTime .. _endTime)\r\n| summarize presion_bar = avg(presion_bar) by bin(ts, 30s), idpozo = tostring(idpozo)\r\n| render timechart",
      "id": "3e4f6316-6c18-4246-9f0a-deed70d8a1cb",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    }
  ],
